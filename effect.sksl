// Scarlet Rot Butterfly Effect (Owlbear Rodeo SKSL)
uniform float u_time;
uniform sampler2D u_texture;
varying vec2 v_texCoord;

float hash(vec2 p) {
    p = fract(p * vec2(123.34, 456.21));
    p += dot(p, p + 34.23);
    return fract(p.x * p.y);
}

float noise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f*f*(3.0 - 2.0*f);
    float a = hash(i);
    float b = hash(i + vec2(1.0, 0.0));
    float c = hash(i + vec2(0.0, 1.0));
    float d = hash(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float scarletMotes(vec2 uv) {
    float t = u_time * 0.4;
    float strength = 0.0;
    for (float i = 1.0; i <= 10.0; i++) {
        vec2 pos = vec2(hash(vec2(i, 0.0)), hash(vec2(0.0, i)));
        pos = pos * 2.0 - 1.0;
        pos.y += sin(t + i * 0.6) * 0.2;
        pos.x += cos(t * 0.5 + i) * 0.15;
        float d = length(uv - pos);
        strength += 0.1 / (d + 0.1);
    }
    return strength;
}

vec3 rotBloom(vec2 uv) {
    float n = noise(uv * 3.0 + vec2(u_time * 0.1, 0.0));
    float pulse = sin(u_time * 0.7) * 0.2 + 0.8;
    vec3 rotColor = vec3(0.85, 0.1, 0.2) * pulse;
    vec3 glowColor = vec3(1.0, 0.4, 0.6) * (n * 0.6);
    return rotColor + glowColor;
}

void main() {
    vec2 uv = v_texCoord * 2.0 - 1.0;
    vec4 base = texture(u_texture, v_texCoord);
    float motes = scarletMotes(uv);
    vec3 bloom = rotBloom(uv);
    vec3 color = base.rgb;
    color += motes * vec3(0.9, 0.2, 0.3);
    color = mix(color, bloom, 0.25);
    color *= 0.95;
    gl_FragColor = vec4(color, base.a);
}